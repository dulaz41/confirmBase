# Environment: development, production, testing
APP_ENV=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Connection (Async driver for FastAPI)
DATABASE_URL=postgresql+asyncpg://waitlist_user:waitlist_secure_pass@db:5432/waitlist_db

# PostgreSQL Connection (Sync driver for Alembic and migration scripts)
SYNC_DATABASE_URL=postgresql://waitlist_user:waitlist_secure_pass@db:5432/waitlist_db

# CORS Allowed Origins (Comma-separated, never use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Authentication (API Key used via 'Authorization: Bearer <ADMIN_API_KEY>')
ADMIN_API_KEY=change_this_to_a_secure_random_admin_key_in_production

# Rate Limiting
WAITLIST_RATE_LIMIT=10
WAITLIST_RATE_WINDOW_SECONDS=60
ADMIN_RATE_LIMIT=30
ADMIN_RATE_WINDOW_SECONDS=60

# Request Body Limit (in bytes, e.g. 10240 = 10KB)
MAX_REQUEST_BODY_SIZE_BYTES=10240

# Backup Configuration
BACKUP_SCHEDULE_HOUR_UTC=2
BACKUP_SCHEDULE_MINUTE_UTC=0
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=local

# Optional: Backup Encryption (Fernet key, generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BACKUP_ENCRYPTION_KEY=

# Optional: S3 Object Storage Configuration for Off-site Backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# --- Transactional Confirmation Email Configuration ---
# Whether to send confirmation emails when a user joins the waitlist
SEND_CONFIRMATION_EMAIL=true

# Provider backend to use: 'console' (dev/test), 'smtp', 'resend', or 'sendgrid'
EMAIL_PROVIDER=console

# Sender identity
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Waitlist Team"
EMAIL_SUBJECT="You're on the waitlist! 🎉"
PRODUCT_NAME="Our Product"
COMPANY_NAME="Waitlist Inc."

# SMTP Settings (Used when EMAIL_PROVIDER=smtp - e.g. AWS SES, Postmark, Brevo, Gmail)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

# Resend API Key (Used when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SendGrid API Key (Used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
